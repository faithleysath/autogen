# LangSmith hosted tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=

# Optional. If omitted, LangSmith creates / uses the default tracing project.
LANGSMITH_PROJECT=autogen-local

# Optional. Set this only if your API key is linked to multiple workspaces.
LANGSMITH_WORKSPACE_ID=

# Optional. The hosted LangSmith SDK usually does not need this.
# Leave empty unless you intentionally need a non-default endpoint.
LANGSMITH_ENDPOINT=

# Likely needed once the orchestrator starts calling models.
OPENAI_API_KEY=
