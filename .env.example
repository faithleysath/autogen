# LangSmith hosted tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=

# Optional. If omitted, LangSmith creates / uses the default tracing project.
LANGSMITH_PROJECT=autogen-local

# Optional. Set this only if your API key is linked to multiple workspaces.
LANGSMITH_WORKSPACE_ID=

# Likely needed once the orchestrator starts calling models.
OPENAI_API_KEY=

# Required. Absolute host path for shared run workspaces. The orchestrator
# container mounts this path at the exact same absolute path so it can hand
# child workspace directories to Docker without a second path translation layer.
AUTOGEN_WORKSPACE_ROOT=/absolute/path/to/autogen-workspaces

# Optional. Defaults to ${AUTOGEN_WORKSPACE_ROOT}/_state.
AUTOGEN_STATE_DIR=

# Optional. Defaults to ${AUTOGEN_STATE_DIR}/orchestrator.sqlite.
AUTOGEN_SQLITE_PATH=

# Optional but recommended. Used so shared workspaces stay editable on the host.
HOST_UID=
HOST_GID=

# Optional. Default git identity for orchestrated commits.
AUTOGEN_GIT_USER_NAME=Autogen
AUTOGEN_GIT_USER_EMAIL=autogen@local

# Optional. Override default execution images.
AUTOGEN_DEV_IMAGE=autogen-agent-dev
AUTOGEN_E2E_IMAGE=autogen-agent-e2e

# Optional. Per-role model overrides.
AUTOGEN_MODEL_DEFAULT=gpt-5.4
AUTOGEN_MODEL_ARCHITECT=
AUTOGEN_MODEL_DEVELOPER=
AUTOGEN_MODEL_GATE=
AUTOGEN_MODEL_REVIEW=
AUTOGEN_MODEL_RELEASE=

# Optional runtime limits in seconds.
AUTOGEN_CMD_TIMEOUT_SECONDS=300
AUTOGEN_CONTAINER_START_TIMEOUT_SECONDS=60
AUTOGEN_REVIEW_TIMEOUT_SECONDS=900
AUTOGEN_PUSH_LOCK_TIMEOUT_SECONDS=120

# Optional. Local SSH material for agent containers, relative to the repo root.
AGENT_SSH_DIR=./.secrets/ssh
